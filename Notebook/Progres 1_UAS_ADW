        "from statsmodels.tsa.stattools import kpss\n",
        "\n",
        "def uji_stasioner(series, nama, reg='c'):\n",
        "    s = series.dropna()\n",
        "    adf_stat, adf_p, *_ = adfuller(s, regression=reg, autolag='AIC')\n",
        "    kpss_stat, kpss_p, *_ = kpss(s, regression=reg, nlags='auto')\n",
        "\n",
        "    adf_stasioner = adf_p < 0.05\n",
        "    kpss_stasioner = kpss_p >= 0.05\n",
        "\n",
        "    if adf_stasioner and kpss_stasioner:\n",
        "        kesimpulan = 'Stasioner'\n",
        "    elif (not adf_stasioner) and (not kpss_stasioner):\n",
        "        kesimpulan = 'Tidak Stasioner'\n",
        "    else:\n",
        "        kesimpulan = 'Tidak Konklusif'\n",
        "\n",
        "    return {\n",
        "        'Deret': nama,\n",
        "        'Spesifikasi': 'konstanta' if reg == 'c' else 'konstanta + tren',\n",
        "        'ADF Stat': round(adf_stat, 4),\n",
        "        'ADF p-value': round(adf_p, 4),\n",
        "        'KPSS Stat': round(kpss_stat, 4),\n",
        "        'KPSS p-value': round(kpss_p, 4),\n",
        "        'Kesimpulan': kesimpulan,\n",
        "    }\n",
        "\n",
        "y_log = np.log(y)\n",
        "\n",
        "deret = {\n",
        "    'Data Asli': y,\n",
